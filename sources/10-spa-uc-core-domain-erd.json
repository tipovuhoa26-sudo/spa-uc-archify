  "cards": [
    {
      "dot": "cyan",
      "title": "Khóa Nội Bộ Khách Hàng & Tách Biệt Dữ Liệu Y Khoa (NT4 / SEC-008)",
      "items": [
        "customers.id là UUID nội bộ; số điện thoại mobile_e164 chỉ dùng để tìm kiếm khử trùng lặp và gộp hồ sơ có nhật ký (merged_into).",
        "customers.safety_flags hiển thị cho Lễ tân khi check-in, còn clinical_records.soap_cipher chỉ mở cho KTV phụ trách ca và Quản lý."
      ]
    },
    {
      "dot": "emerald",
      "title": "Bảng Giá Kép Cash/Card & Hai Thời Điểm Ghi Nhận GST (PAY-001 / NT6)",
      "items": [
        "Bảng services lưu song song cash_price và card_price để tuân thủ lệnh cấm phụ phí thẻ của RBA từ 01/10/2026.",
        "Trường gst_mode phân biệt rõ Monetary Voucher (tính GST khi sử dụng) với Specific-Service Package (tính GST khi phát hành)."
      ]
    },
    {
      "dot": "amber",
      "title": "Chống Trùng Lịch TSTZRANGE & Khóa Sổ Lương Bất Biến (NT18 / COM-006)",
      "items": [
        "appointments.slot_range dùng ràng buộc loại trừ TSTZRANGE của PostgreSQL trên từng staff_id để chặn tuyệt đối việc đặt trùng giờ liên chi nhánh.",
        "payroll_snapshots đóng băng giờ công 2 tuần, giờ di chuyển có lương, hoa hồng và tiền tip ngay khi lock_state = LOCKED."
      ]
    }
  ]
