{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/toan-bo-luong",
      "destination": "/index.html"
    },
    {
      "source": "/00-spa-uc-tong-quan-kien-truc-tieng-viet-explainer",
      "destination": "/index.html"
    },
    {
      "source": "/00-spa-uc-tong-quan-kien-truc-tieng-viet-explainer.html",
      "destination": "/index.html"
    },
    {
      "source": "/15-spa-uc-7-luong-van-hanh-toan-dien-explainer",
      "destination": "/index.html"
    },
    {
      "source": "/15-spa-uc-7-luong-van-hanh-toan-dien-explainer.html",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/previews/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

